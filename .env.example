# TaxPilot configuration. Copy to `.env` and adjust. No secrets are required to
# run in demo mode. Production OAuth secrets must be supplied through a secret
# manager, never committed.

# Port the local server listens on.
PORT=3000

# Binance Agent OS MCP endpoint (Streamable HTTP). Override only for staging.
AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# Node runtime env: 'production' enables Secure cookies and disables the MCP proxy.
NODE_ENV=development

# Location of persisted user data (sessions, encrypted tokens, reports, decisions,
# lots, audit log). Defaults to `.taxpilot-data/` under the working directory.
# On Railway: mount a Volume at /data and set TAXPILOT_DATA_DIR=/data.
TAXPILOT_DATA_DIR=.taxpilot-data

# Enable the dev-only MCP proxy at /api/mcp. Never enable in production.
ENABLE_MCP_PROXY=false

# Binance OAuth (Binance Login) Authorization Code + PKCE.
#
# ⚠  Binance Login OAuth 2.0 is currently offered ONLY to close ecosystem
# partners. Client credentials are not self-service — contact the Binance
# business team to onboard. See README §Production deployment step 1.
# Docs: https://developers.binance.com/en/docs/products/login/introduction
#
# The endpoints below are the documented production URLs and are already the
# code defaults; leave them blank to use the defaults, or override for staging.
BINANCE_OAUTH_CLIENT_ID=
BINANCE_OAUTH_CLIENT_SECRET=
BINANCE_OAUTH_AUTHORIZATION_ENDPOINT=https://accounts.binance.com/en/oauth/authorize
BINANCE_OAUTH_TOKEN_ENDPOINT=https://accounts.binance.com/oauth/token
BINANCE_OAUTH_REVOCATION_ENDPOINT=
BINANCE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/binance/callback
# Binance uses COMMA-separated scopes (not space-separated per standard OAuth 2.0).
# Documented examples: user:openId, create:apikey
# The exact read-only tax scope names come from your onboarding contact.
BINANCE_OAUTH_SCOPES=
# 'basic' (Authorization header) or 'body' (form body). Binance accepts both.
BINANCE_OAUTH_CLIENT_AUTH=body

# 32+ bytes of entropy. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
